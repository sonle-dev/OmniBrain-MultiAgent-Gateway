# ==============================================================================
# OMNIBRAIN AI GATEWAY — MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Lưu ý: Tuyệt đối không commit file .env chứa key thật lên GitHub!
# ==============================================================================

# 1. Cấu hình Server Gateway
PORT=8000
HOST=127.0.0.1
DEBUG=True
API_KEY=your_secret_gateway_api_key_here

# 2. Hạ tầng Local Ollama (Mặc định Zero-Key)
OLLAMA_BASE_URL=http://localhost:11434
MODEL_CHAT_LOCAL=ollama/qwen2.5:7b
MODEL_REASONING_LOCAL=ollama/deepseek-r1:8b
MODEL_EMBEDDING_LOCAL=ollama/nomic-embed-text

# 3. Cấu hình Cloud Fallback (Tùy chọn - Chỉ dùng khi Local quá tải)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# 4. Cơ sở dữ liệu & Caching
SEMANTIC_CACHE_PATH=semantic_cache.db
LMS_DB_PATH=lms_data.db
